# Copy to .env (git-ignored) and fill in. Never commit real values.
NODE_ENV=development
LOG_LEVEL=info
APP_URL=http://127.0.0.1:3000

# Local Postgres from docker-compose (npm run db:up). Use your Neon URL in production.
DATABASE_URL=postgres://app:app@127.0.0.1:54329/concert
# Postgres pool size per process. Default: 2 on Vercel, 5 elsewhere (docs/DEPLOY.md).
DB_POOL_MAX=

# Spotify developer app (https://developer.spotify.com/dashboard)
# Redirect URI to register: http://127.0.0.1:3000/api/auth/spotify/callback
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=

# openssl rand -base64 32
TOKEN_ENC_KEY=
TOKEN_ENC_KEY_VERSION=1
# openssl rand -base64 48
SESSION_SECRET=

# https://developer.ticketmaster.com (free key)
TICKETMASTER_API_KEY=

# Your Spotify user ID(s), comma-separated, for admin screens
ADMIN_SPOTIFY_USER_IDS=

# https://www.last.fm/api/account/create (free; used for "most listened" songs, D-038)
LASTFM_API_KEY=

# https://www.setlist.fm/settings/api (free, non-commercial; 2 req/s, 1440/day; attribution link required, D-051)
SETLISTFM_API_KEY=

# Dedicated app contact mailbox for API etiquette (Wikimedia User-Agent), D-059. Not a personal email.
APP_CONTACT_EMAIL=
TAVILY_API_KEY=
GITHUB_MODELS_TOKEN=
GITHUB_MODELS_MODEL=

# D-060 alerts (scheduled jobs only). Gmail with an app password; leave user/pass empty to
# send alerts to the GitHub Actions job summary instead (docs/DEPLOY.md section 7).
ALERT_SMTP_HOST=smtp.gmail.com
ALERT_SMTP_PORT=465
ALERT_SMTP_USER=
ALERT_SMTP_PASS=
ALERT_EMAIL_TO=lineupmixes@gmail.com
